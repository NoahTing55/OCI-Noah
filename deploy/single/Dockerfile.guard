FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --gid 10001 guard && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin guard
COPY backend/app/docker_socket_guard.py /app/app/docker_socket_guard.py
RUN mkdir -p /app/app /run/oci-guard && chown -R guard:guard /app /run/oci-guard
USER guard
CMD ["python", "-m", "app.docker_socket_guard"]
